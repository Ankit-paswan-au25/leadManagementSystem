{
  "name": "sales-management-l3",
  "version": "1.0.0",
  "description": "Sales Management System - Backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "prod": "cross-env NODE_ENV=production node src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "seed:users": "node src/scripts/seedUsers.js",
    "seed:users:reset": "cross-env RESET_PASSWORDS=true node src/scripts/seedUsers.js",
    "seed:leads": "node src/scripts/seedLeads.js",
    "seed:leads:clear": "cross-env CLEAR_LEADS=true node src/scripts/seedLeads.js",
    "seed:products": "node src/scripts/seedProducts.js",
    "seed:products:reset": "cross-env CLEAR_PRODUCTS=true node src/scripts/seedProducts.js",
    "seed:customers": "node src/scripts/seedCustomers.js",
    "seed:customers:reset": "cross-env CLEAR_CUSTOMERS=true node src/scripts/seedCustomers.js",
    "seed:notifications": "node src/scripts/seedNotifications.js",
    "seed:notifications:reset": "cross-env CLEAR_NOTIFICATIONS=true node src/scripts/seedNotifications.js",
    "seed:ownership-requests": "node src/scripts/seedOwnershipRequests.js",
    "seed:ownership-requests:reset": "cross-env CLEAR_OWNERSHIP_REQUESTS=true node src/scripts/seedOwnershipRequests.js",
    "seed:activities": "node src/scripts/seedActivities.js",
    "seed:activities:reset": "cross-env CLEAR_ACTIVITIES=true node src/scripts/seedActivities.js",
    "seed:all-admin": "npm run seed:notifications && npm run seed:ownership-requests && npm run seed:activities"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}